# Temporary local demo only. This Vite variable is exposed in the browser bundle.
# Put your CoinStats Open API key in your untracked local .env file; never commit the real key.
VITE_COINSTATS_API_KEY=replace_with_your_coinstats_key

# Temporary local demo only. A Vite key is bundled into public browser code;
# do not set this in production hosting. Proxy Ankr calls through the backend before launch.
VITE_ANKR_API_KEY=replace_with_your_ankr_key

# Optional CoinGecko key for price history and search
VITE_COINGECKO_API_KEY=replace_with_your_coingecko_key
