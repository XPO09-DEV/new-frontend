# The backend API origin is not secret. For local Vite development use http://127.0.0.1:4000.
# In production, set your deployed API origin or leave blank for same-origin reverse proxy.
VITE_SUBTLEPAY_API_BASE_URL=http://localhost:4000
VITE_SUBTLEPAY_WALLET_ASSETS_PATH=/api/wallet/assets

# Provider credentials are configured on the backend only, never in VITE_* variables.
