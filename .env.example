# TEMPORARY LOCAL-ONLY CONFIGURATION
# Vite variables are bundled into browser-accessible frontend code.
# The Ankr key is visible to users. Do not use this mode in a public deployment.
VITE_ANKR_API_KEY=replace_with_your_rotated_ankr_key

# Optional demo market-data key. This is also visible in the browser bundle.
VITE_COINGECKO_API_KEY=replace_with_your_coingecko_key
VITE_COINSTATS_API_KEY=replace_with_your_coinstats_key
