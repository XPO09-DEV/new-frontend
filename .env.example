# Frontend-to-backend connection. Leave the base URL empty when the backend is
# reverse-proxied under the same origin; otherwise set it to your backend's origin.
VITE_SUBTLEPAY_API_BASE_URL=
VITE_SUBTLEPAY_WALLET_ASSETS_PATH=/api/wallet/assets

# API credentials must live on the backend/server environment, never in VITE_ variables.
# Configure ANKR_API_KEY on your backend; do not add VITE_ANKR_API_KEY here.

# Optional local/demo CoinGecko key. VITE_ values are visible in browser code;
# proxy any private/paid provider credential through the backend for production.
VITE_COINGECKO_API_KEY=replace_with_your_coingecko_key

# CoinStats key is also browser-visible if enabled by the frontend.
VITE_COINSTATS_API_KEY=replace_with_your_coinstats_key
